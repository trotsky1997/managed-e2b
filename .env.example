# me2b 配置示例 — 复制为 .env 并填入真实凭据 (.env 不提交到 git)
# E2B 官方账号
E2B_API_KEY=e2b_your_key_here
# 可选: 火山方舟 E2B 镜像端点 (火山环境必填)
# E2B_API_URL=https://api.vefaas-e2b.sandbox-cn-beijing.volcapig.com
# 火山 TOS (mount_tos 用; AK 无尾部 =, SK 是 base64 直接用)
E2B_TOS_AK=AKLTyour_access_key
E2B_TOS_SK=your_secret_key
# sqlite 路径 (跨运行需稳定复用以支持崩溃恢复)
# ME2B_DB_PATH=me2b.db
